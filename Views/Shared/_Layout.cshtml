<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpenseTracker</title>
    <script type="importmap"></script>

    <!--
        Apply the saved theme BEFORE any stylesheet loads or the page paints.
        This must be a plain, render-blocking inline script placed here in
        <head> (not at the bottom of <body>, not inside DOMContentLoaded) —
        otherwise the browser paints once in light mode first, then flips to
        dark a moment later, which is the white flash on navigation.
    -->
    <script>
            (function() {
                if (localStorage.getItem("theme") === "dark") {
                    document.documentElement.setAttribute("data-theme", "dark");
                }
            })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="app-shell">

        <!-- Sidebar -->
        <aside id="sidebar" class="sidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-brand text-decoration-none">

                <span class="brand-icon">
                    <i class="bi bi-wallet2"></i>
                </span>

                <span class="brand-text">
                    ExpenseTracker
                </span>

            </a>

            <ul class="sidebar-nav">

                <li class="nav-item">
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Expense"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expense" ? "active" : "")">
                        <i class="bi bi-cash-stack"></i>
                        <span>Expenses</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Income"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Income" ? "active" : "")">
                        <i class="bi bi-currency-rupee"></i>
                        <span>Income</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Budget"
                       asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "active" : "")">
                        <i class="bi bi-piggy-bank"></i>
                        <span>Budget</span>
                    </a>
                </li>

            </ul>

        </aside>

        <!-- Main Content -->
        <div id="mainContent" class="main-col">

            <nav class="topbar">
                <button id="toggleSidebar"
                        class="btn btn-light btn-sm me-3">

                    <i class="bi bi-list"></i>

                </button>

                <div class="d-flex align-items-center gap-3">

                    <button id="themeToggle"
                            class="btn btn-light btn-sm">

                        <i class="bi bi-moon"></i>

                    </button>

                    <partial name="_LoginPartial" />

                </div>

            </nav>

            <div class="page-body">
                @RenderBody()
            </div>

        </div>

    </div>

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3">

            @if (TempData["Success"] != null)
            {
                <div id="successToast"
                     class="toast align-items-center text-bg-success border-0"
                     role="alert"
                     aria-live="assertive"
                     aria-atomic="true">

                    <div class="d-flex">

                        <div class="toast-body">

                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]

                        </div>

                        <button type="button"
                                class="btn-close btn-close-white me-2 m-auto"
                                data-bs-dismiss="toast"
                                aria-label="Close">
                        </button>

                    </div>

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div id="errorToast"
                     class="toast align-items-center text-bg-danger border-0 mt-2"
                     role="alert"
                     aria-live="assertive"
                     aria-atomic="true">

                    <div class="d-flex">

                        <div class="toast-body">

                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]

                        </div>

                        <button type="button"
                                class="btn-close btn-close-white me-2 m-auto"
                                data-bs-dismiss="toast"
                                aria-label="Close">
                        </button>

                    </div>

                </div>
            }

        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
            document.addEventListener("DOMContentLoaded", function() {

                // ==========================
                // Toast Notifications
                // ==========================
                var successToast = document.getElementById("successToast");

                if (successToast) {
                    new bootstrap.Toast(successToast, {
                        delay: 3000,
                        animation: true
                    }).show();
                }

                var errorToast = document.getElementById("errorToast");

                if (errorToast) {
                    new bootstrap.Toast(errorToast, {
                        delay: 4000,
                        animation: true
                    }).show();
                }

                // ==========================
                // Sidebar Toggle
                // ==========================
                const sidebar = document.getElementById("sidebar");
                const toggle = document.getElementById("toggleSidebar");

                if (sidebar && toggle) {
                    toggle.addEventListener("click", function() {
                        sidebar.classList.toggle("collapsed");
                    });
                }

                // ==========================
                // Dark Mode
                // ==========================
                const themeButton = document.getElementById("themeToggle");

                if (themeButton) {

                    const icon = themeButton.querySelector("i");

                    // Theme itself was already applied in <head> before paint;
                    // here we just sync the icon to match on load.
                    const isDarkOnLoad =
                        document.documentElement.getAttribute("data-theme") === "dark";

                    icon.className = isDarkOnLoad ? "bi bi-sun" : "bi bi-moon";

                    themeButton.addEventListener("click", function() {

                        const isDark =
                            document.documentElement.getAttribute("data-theme") === "dark";

                        if (isDark) {

                            document.documentElement.removeAttribute("data-theme");

                            localStorage.setItem("theme", "light");

                            icon.className = "bi bi-moon";

                        } else {

                            document.documentElement.setAttribute("data-theme", "dark");

                            localStorage.setItem("theme", "dark");

                            icon.className = "bi bi-sun";
                        }

                    });
                }

            });
    </script>

</body>
</html>
