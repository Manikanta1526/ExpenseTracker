@model ExpenseTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card text-bg-primary mb-3">
            <div class="card-body">
                <h5>Total Income</h5>
                <h3>@Model.TotalIncome.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-danger mb-3">
            <div class="card-body">
                <h5>Total Expense</h5>
                <h3>@Model.TotalExpense.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-success mb-3">
            <div class="card-body">
                <h5>Savings</h5>
                <h3>@Model.Savings.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-warning mb-3">
            <div class="card-body">
                <h5>Transactions</h5>
                <h3>@Model.TotalTransactions</h3>
            </div>
        </div>
    </div>

</div>

<!-- Recent Transactions Section -->

<div class="row mt-4">

    <!-- Recent Expenses -->

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-danger text-white">
                Recent Expenses
            </div>

            <div class="card-body">

                @if (Model.RecentExpenses != null && Model.RecentExpenses.Any())
                {
                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentExpenses)
                            {
                                <tr>
                                    <td>@item.Title</td>
                                    <td>@item.Amount.ToString("C")</td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted">No expenses found.</p>
                }

            </div>

        </div>

    </div>

    <!-- Recent Income -->

    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">
                Recent Income
            </div>

            <div class="card-body">

                @if (Model.RecentIncomes != null && Model.RecentIncomes.Any())
                {
                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentIncomes)
                            {
                                <tr>
                                    <td>@item.Source</td>
                                    <td>@item.Amount.ToString("C")</td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted">No income found.</p>
                }

            </div>

        </div>

    </div>

</div>