@model ExpenseTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<!-- Summary Cards -->
<div class="row g-4">

    <div class="col-lg-3 col-md-6">
        <div class="card dashboard-card income-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Income</h6>
                    <h3>@Model.TotalIncome.ToString("C")</h3>
                </div>
                <i class="bi bi-cash-stack display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card dashboard-card expense-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Expense</h6>
                    <h3>@Model.TotalExpense.ToString("C")</h3>
                </div>
                <i class="bi bi-wallet2 display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card dashboard-card savings-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Savings</h6>
                    <h3>@Model.Savings.ToString("C")</h3>
                </div>
                <i class="bi bi-piggy-bank display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card dashboard-card transaction-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Transactions</h6>
                    <h3>@Model.TotalTransactions</h3>
                </div>
                <i class="bi bi-receipt display-4"></i>
            </div>
        </div>
    </div>

</div>

<!-- Charts -->
<div class="row mt-4">

    <!-- Expense by Category -->
    <div class="col-lg-6">

        <div class="card shadow-lg border-0 rounded-4">

            <div class="card-header fw-bold fs-5">
                Expense by Category
            </div>

            <div class="card-body">

                <div style="height:350px;">
                    <canvas id="expensePieChart"></canvas>
                </div>

            </div>

        </div>

    </div>

   

    <!-- Monthly Expense Chart -->
    <div class="col-lg-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">
                Monthly Expenses
            </div>

            <div class="card-body">

                <div style="height:350px;">
                    <canvas id="monthlyExpenseChart"></canvas>
                </div>

            </div>

        </div>

    </div>

</div>

<div class="card shadow-lg border-0 rounded-4 mt-4">

    <div class="card-header fw-bold">
        Monthly Budget
    </div>

    <div class="card-body">

        <h5>Budget</h5>

        <h3>@Model.MonthlyBudget.ToString("C")</h3>

        <div class="progress mt-3" style="height:28px;">

            <div class="progress-bar bg-success"
                 role="progressbar"
                 style="width:@Model.BudgetUsedPercentage%">

                @Model.BudgetUsedPercentage.ToString("0")%

            </div>

        </div>

        <div class="mt-3">

            <strong>Remaining:</strong>

            @Model.RemainingBudget.ToString("C")

        </div>

        @if (Model.IsBudgetExceeded)
        {
            <div class="alert alert-danger mt-3">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Budget exceeded this month!
            </div>
        }
        else
        {
            <div class="alert alert-success mt-3">
                <i class="bi bi-check-circle-fill"></i>
                You're within your budget.
            </div>
        }

    </div>

</div>


<div class="card shadow-lg border-0 rounded-4 mt-4">

    <div class="card-header fw-bold">
        Financial Insights
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4">
                <h6>Highest Expense</h6>
                <h4>@Model.HighestExpense.ToString("C")</h4>
            </div>

            <div class="col-md-4">
                <h6>Average Expense</h6>
                <h4>@Model.AverageExpense.ToString("C")</h4>
            </div>

            <div class="col-md-4">
                <h6>Top Spending Category</h6>
                <h4>@Model.TopCategory</h4>
            </div>

        </div>

    </div>

</div>

<div class="mt-4 text-end">

    <a asp-action="ExportExcel"
       class="btn btn-success">

        <i class="bi bi-file-earmark-excel"></i>

        Export Excel

    </a>

    <a asp-action="ExportPdf"
       class="btn btn-danger">

        <i class="bi bi-file-earmark-pdf"></i>

        Export PDF

    </a>

</div>

<!-- Recent Transactions -->
<div class="row mt-4">

    <!-- Recent Expenses -->
    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-danger text-white">
                Recent Expenses
            </div>

            <div class="card-body">

                @if (Model.RecentExpenses != null && Model.RecentExpenses.Any())
                {
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentExpenses)
                            {
                                <tr>
                                    <td>@item.Title</td>
                                    <td>@item.Amount.ToString("C")</td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted">No expenses found.</p>
                }

            </div>

        </div>

    </div>

    <!-- Recent Income -->
    <div class="col-md-6">

        <div class="card shadow">

            <div class="card-header bg-success text-white">
                Recent Income
            </div>

            <div class="card-body">

                @if (Model.RecentIncomes != null && Model.RecentIncomes.Any())
                {
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Source</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentIncomes)
                            {
                                <tr>
                                    <td>@item.Source</td>
                                    <td>@item.Amount.ToString("C")</td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted">No income found.</p>
                }

            </div>

        </div>

    </div>

</div>

<!-- Budget Usage -->
<div class="card mt-4">

    <div class="card-header">
        Budget Usage
    </div>

    <div class="card-body">

        <div class="progress" style="height:25px;">

            <div class="progress-bar bg-success"
                 role="progressbar"
                 style="width:@Model.BudgetUsedPercentage%">

                @Model.BudgetUsedPercentage.ToString("0")%

            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-6">
                <h5>Remaining Budget</h5>
                <h4>@Model.RemainingBudget.ToString("C")</h4>
            </div>

            <div class="col-md-6 text-end">
                <h5>Monthly Budget</h5>
                <h4>@Model.MonthlyBudget.ToString("C")</h4>
            </div>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        const labels = [
                @foreach (var item in Model.ExpenseCategoryChart)
            {
                @: "@item.Category",
            }
                ];

        const data = [
                @foreach (var item in Model.ExpenseCategoryChart)
            {
                @: @item.TotalAmount,
            }
                ];

        const ctx = document.getElementById('expensePieChart');

        new Chart(ctx, {

            type: 'pie',

            data: {

                labels: labels,

                datasets: [{

                    label: 'Expenses',

                    data: data,

                    backgroundColor: [
                        '#4e79a7',
                        '#f28e2b',
                        '#e15759',
                        '#76b7b2',
                        '#59a14f',
                        '#edc948',
                        '#b07aa1',
                        '#ff9da7',
                        '#9c755f',
                        '#bab0ab'
                    ],

                    borderWidth: 1

                }]
            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        position: 'bottom'

                    }

                }

            }

        });


        const monthlyLabels = [
        @foreach (var item in Model.MonthlyExpenseChart)
            {
                @: "@item.Month",
            }
        ];

        const monthlyData = [
        @foreach (var item in Model.MonthlyExpenseChart)
            {
                @: @item.TotalExpense,
            }
        ];

        const monthlyCtx = document.getElementById('monthlyExpenseChart');

        new Chart(monthlyCtx, {

            type: 'line',

            data: {

                labels: monthlyLabels,

                datasets: [{

                    label: 'Monthly Expenses',

                    data: monthlyData,

                    borderColor: '#198754',

                    backgroundColor: 'rgba(25,135,84,0.2)',

                    fill: true,

                    tension: 0.4

                }]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        display: true
                    }

                }

            }

        });

    </script>
}