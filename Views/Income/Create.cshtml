@model ExpenseTracker.ViewModels.IncomeViewModel

@{
    ViewData["Title"] = "Add Income";
}

<h2>Add Income</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">

        <label asp-for="Source"></label>

        <input asp-for="Source"
               class="form-control" />

        <span asp-validation-for="Source"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Amount"></label>

        <input asp-for="Amount"
               class="form-control" />

        <span asp-validation-for="Amount"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Date"></label>

        <input asp-for="Date"
               type="date"
               class="form-control" />

    </div>

    <button class="btn btn-primary">
        Save Income
    </button>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}