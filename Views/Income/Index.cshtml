@model IEnumerable<ExpenseTracker.Models.Income>

@{
    ViewData["Title"] = "Income";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Income</h2>
        <p class="text-muted mb-0">Every income source you've logged.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i>
        Add Income
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">

            <i class="bi bi-cash-coin"></i>

            <h3>
                No Income Yet
            </h3>

            <p>
                Start by adding your first income source.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Add Income
            </a>

        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>Source</th>

                        <th>Amount</th>

                        <th>Date</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Source</td>

                            <td>@item.Amount.ToString("C")</td>

                            <td>@item.Date.ToShortDateString()</td>

                            <td>

                                <div class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.IncomeId"
                                       class="btn-icon btn-icon-edit"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.IncomeId"
                                       class="btn-icon btn-icon-delete"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>
}
