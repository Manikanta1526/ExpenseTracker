@model ExpenseTracker.Models.Income

<h2 class="text-danger">Delete Income</h2>

<h4>Are you sure?</h4>

<form asp-action="Delete" method="post">

    <input asp-for="IncomeId" type="hidden" />

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>