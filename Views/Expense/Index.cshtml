@model ExpenseTracker.ViewModels.ExpenseFilterViewModel

@{
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold mb-0">Expenses</h2>
        <p class="text-muted mb-0">Every expense you've logged, filterable by category and date.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i>
        Add Expense
    </a>
</div>

<!-- Filter Form Starts Here -->

<div class="card mb-3">
    <div class="card-body">

        <form method="get" class="row g-2 align-items-center">

            <div class="col-md-3">
                <input asp-for="SearchTerm"
                       class="form-control"
                       placeholder="Search Title" />
            </div>

            <div class="col-md-2">

                <select asp-for="CategoryId"
                        asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))"
                        class="form-select">

                    <option value="">All Categories</option>

                </select>

            </div>

            <div class="col-md-2">

                <input asp-for="StartDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <input asp-for="EndDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="Date">Newest</option>

                    <option value="Amount">Highest Amount</option>

                </select>

            </div>

            <div class="col-md-1">

                <button class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                </button>

            </div>

        </form>

    </div>
</div>

<!-- Filter Form Ends Here -->
@if (!Model.Expenses.Any())
{
    <div class="card">
        <div class="empty-state">

            <i class="bi bi-wallet2"></i>

            <h3>
                No Expenses Yet
            </h3>

            <p>
                Start by adding your first expense.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Add Expense
            </a>

        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Expenses)
                    {
                        <tr>

                            <td>@item.Title</td>

                            <td>@item.Amount.ToString("C")</td>

                            <td>
                                @{
                                    var badge = item.Category?.Name switch
                                    {
                                        "Food" => "bg-success",
                                        "Transport" => "bg-primary",
                                        "Shopping" => "bg-warning text-dark",
                                        "Bills" => "bg-danger",
                                        "Health" => "bg-info text-dark",
                                        "Education" => "bg-dark",
                                        "Entertainment" => "bg-purple",
                                        "Salary" => "bg-success",
                                        "Other" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };
                                }

                                <span class="badge @badge">
                                    @item.Category?.Name
                                </span>
                            </td>

                            <td>@item.Date.ToString("dd MMM yyyy")</td>

                            <td>
                                <div class="row-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ExpenseId"
                                       class="btn-icon btn-icon-edit"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ExpenseId"
                                       class="btn-icon btn-icon-delete"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <nav class="mt-4">

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.PageNumber == i ? "active" : "")">

                    <a class="page-link"
                       asp-route-PageNumber="@i"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-CategoryId="@Model.CategoryId"
                       asp-route-StartDate="@Model.StartDate"
                       asp-route-EndDate="@Model.EndDate"
                       asp-route-SortBy="@Model.SortBy">

                        @i

                    </a>

                </li>
            }

        </ul>

    </nav>
}
