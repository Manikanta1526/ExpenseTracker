@model ExpenseTracker.ViewModels.BudgetViewModel

@{
    ViewData["Title"] = "Budget";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">Monthly Budget</h2>

        <p class="text-muted mb-0">
            Set your spending limit for this month.
        </p>

    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
    </div>
}

<div class="card shadow-sm">

    <div class="card-header">
        Budget Settings
    </div>

    <div class="card-body">

        <form asp-action="Index" method="post">

            <div class="mb-4">

                <label asp-for="MonthlyBudget"
                       class="form-label fw-semibold">
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        ₹
                    </span>

                    <input asp-for="MonthlyBudget"
                           class="form-control form-control-lg" />

                </div>

                <span asp-validation-for="MonthlyBudget"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-circle me-2"></i>

                Save Budget

            </button>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}